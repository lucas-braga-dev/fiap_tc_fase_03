# Local tools and credentials
.tools/
.aws/
.kube/
.ssh/
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Kubernetes secrets (keep sanitized examples)
**/secrets/*.yaml
**/secrets/*.yml
!**/secrets/*.example.yaml
!**/secrets/*.example.yml

# Terraform downloads, local variables, state and plans
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
*.plan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
# Keep .terraform.lock.hcl for reproducible provider versions.
backend.hcl

# Python dependencies and generated files
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Build artifacts and test output
bin/
dist/
build/
coverage/
*.test
*.out
*.exe
node_modules/

# Local logs, databases and temporary files
*.log
*.sqlite
*.sqlite3
*.db
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# Editor and operating system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
