# Copie para ~/fiap-tc-fase-03/.env na EC2; nao versione o arquivo preenchido.
# Credenciais nas URLs precisam de percent-encoding quando contem caracteres especiais.
AUTH_DATABASE_URL=postgres://USUARIO:SENHA@HOST_RDS:5432/auth_db?sslmode=require
FLAGS_DATABASE_URL=postgres://USUARIO:SENHA@HOST_RDS:5432/flags_db?sslmode=require
TARGETING_DATABASE_URL=postgres://USUARIO:SENHA@HOST_RDS:5432/targeting_db?sslmode=require
MASTER_KEY=SUBSTITUIR
SERVICE_API_KEY=SUBSTITUIR_POR_CHAVE_EMITIDA_PELO_AUTH
# Outputs Terraform: aws_region, sqs_queue_url e dynamodb_table_name.
AWS_REGION=us-east-2
AWS_SQS_URL=https://sqs.us-east-2.amazonaws.com/CONTA/togglemaster-events-dev
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics-dev
# A IAM Role provisionada fornece credenciais automaticamente.
# Deixe os tres campos abaixo vazios para usar a role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
